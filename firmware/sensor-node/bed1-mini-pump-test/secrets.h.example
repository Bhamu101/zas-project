// Credentials for this sketch — NOT tracked in git (see .gitignore).
//
// Copy secrets.h.example to secrets.h and fill in your own values. Arduino
// compiles every file in the sketch folder, so this header just needs to sit
// next to the .ino.
//
// SHARED_SECRET must match ESP32_SHARED_SECRET in backend/.env (and in
// the Render dashboard for the deployed backend).

#pragma once

const char* WIFI_SSID     = "your-wifi-ssid";
const char* WIFI_PASSWORD = "your-wifi-password";

// Must match ESP32_SHARED_SECRET in the backend's .env / Render.
const char* SHARED_SECRET = "a-long-random-string-matching-the-backend";
