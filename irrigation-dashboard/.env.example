# FastAPI backend. Defaults to http://localhost:8021 when unset.
VITE_API_URL=http://localhost:8021

# Supabase Auth — Supabase dashboard -> Project Settings -> API.
# The publishable key is safe in a browser client (it grants nothing on its
# own). NEVER put the service_role key here — Vite inlines VITE_* vars into
# the built JS, so anything here ships to every visitor.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
