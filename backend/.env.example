# --- Auth (required) ---------------------------------------------------------
# Your Supabase project URL. Every /api/* endpoint verifies the caller's
# `Authorization: Bearer <jwt>` against this project's public JWKS, so the
# backend never sees a password and holds no token-minting secret.
# Find it at: Supabase dashboard -> Project Settings -> Data API -> Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Extra browser origins allowed by CORS, comma-separated. Native mobile fetch
# sends no Origin and is unaffected — this is only for web builds / dashboards
# served from a host not already in the default list in main.py.
# CORS_EXTRA_ORIGINS=https://my-dashboard.example.com,http://192.168.1.42:5173

# --- AI ----------------------------------------------------------------------
GEMINI_API_KEY=AIza...

# Bed 1's ESP32 node (firmware/sensor-node/bed1-manual-irrigation.ino) — only set
# this once that hardware is actually flashed and on the same network as this
# backend. Leave unset (the default) to keep Start/Stop Irrigation as a
# simulation, which is the correct state until the pump/valve are wired up.
# Use the ESP32's LAN IP (from Serial Monitor) or http://irrigation.local if
# mDNS resolves from wherever this backend runs. No trailing slash.
# ESP32_BASE_URL=http://192.168.1.42

# Bed camera (ESP32-CAM, firmware/camera-node/bed1-camera/). The camera sends
# CAMERA_SHARED_SECRET in an X-Camera-Key header — must match SHARED_SECRET in
# the sketch. Frames go to the private Supabase Storage bucket `bed-camera`,
# which only the service-role key can reach. That key is SECRET: server only.
# CAMERA_SHARED_SECRET=some-long-random-string
# SUPABASE_SERVICE_ROLE_KEY=eyJ... or sb_secret_...

# Twilio WhatsApp alerts — from console.twilio.com
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# Sandbox default while testing: +14155238886 (see console.twilio.com/develop/sms/try-it-out/whatsapp-learn)
TWILIO_WHATSAPP_FROM=+14155238886
# Your own phone number, in E.164 format (e.g. +15551234567) — must have joined the sandbox first
TWILIO_WHATSAPP_TO=+1...
