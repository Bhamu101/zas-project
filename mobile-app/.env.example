# Base URL of the FastAPI backend (see ../backend/main.py, run on port 8021).
# "localhost" only works in a web/simulator build on the same machine as the
# backend — a physical phone needs your computer's LAN IP instead, e.g.:
# EXPO_PUBLIC_API_URL=http://192.168.1.42:8021
EXPO_PUBLIC_API_URL=http://localhost:8021
