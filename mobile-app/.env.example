# Base URL of the FastAPI backend (see ../backend/main.py).
#
# For local dev (Expo Go, same WiFi as your computer), use your LAN IP:
# EXPO_PUBLIC_API_URL=http://192.168.1.42:8021
#
# For a standalone build (EAS APK) that needs to work anywhere, this must be
# a public URL — the backend deployed via ../render.yaml, e.g.:
EXPO_PUBLIC_API_URL=https://zas-irrigation-api.onrender.com

# Supabase Auth — from Supabase dashboard -> Project Settings -> API.
# The publishable key is safe to ship in the app (it grants nothing by itself);
# never put the service_role key in this file or anywhere in the client.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
