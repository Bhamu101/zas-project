# Dependencies
node_modules/

# Python
venv/
__pycache__/
*.pyc

# Env / secrets
.env
.env.local

# Build output
dist/
dist-ssr/
*.local

# Claude Code local settings and installed skill packages (reproducible via
# the skills tool, not project source)
.claude/settings.local.json
.claude/skills/
.agents/
claude-android-skill/

# Logs
logs
*.log
npm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store

# Claude Design canvas artifacts — local authoring scratch, not project source.
# Main.dc.html references a support.js that isn't tracked, and the published
# circuit page is a multi-MB single file; both are kept out of git history.
design-canvas/

# Firmware credentials. Each sketch reads WiFi + the backend shared secret from
# a secrets.h next to its .ino; only the .example template is tracked, so the
# farm's WiFi password and the pump/camera shared secrets never reach git.
secrets.h
!secrets.h.example

# Generated video/launch artifacts (hyperframes + brag output) — build output,
# not project source, and large.
videos/
brag-output/

# Vendored upstream checkout with its own .git — would land as a broken
# submodule entry rather than real files.
OmniVoice/
